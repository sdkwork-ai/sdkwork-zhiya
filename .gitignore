# SDKWork repository gitignore — follows REPOSITORY_BASELINE_SPEC.md
# bin/ and sdks/**/generated/ MUST NOT be ignored.

node_modules/
**/node_modules/
dist/
**/dist/
coverage/
**/coverage/
.pnpm-store/
**/.pnpm-store/
.turbo/
**/.turbo/
*.tsbuildinfo
**/.cache/
*.log
*.js.map
**/*.js.map
*.d.ts.map
**/*.d.ts.map

# SDKWork local runtime state
.runtime/
**/.runtime/

# Environment files — examples stay tracked
.env
.env.*
!.env.example
!.env.*.example

# SDKWork local-only workspace state
**/.sdkwork/local/
**/.sdkwork/secrets/
**/.sdkwork/cache/
**/.sdkwork/tmp/
**/.sdkwork/manual-backups/

# Runtime-generated env config (materialized locally)
**/public/runtime-env.json

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sqlite-shm
*.sqlite-wal

# Dart/Flutter build output
.dart_tool/
**/.dart_tool/
build/
**/build/

# ---- auto-audited: local artifacts that must never be committed ----
*.key
*.pem
*.p12
*.pfx
*.keystore
tmp/
temp/
*.tmp
*.temp
.next/
target/

# Per-environment SDKWork materializations are tracked (ENVIRONMENT_SPEC 5.1.7).
# Local values (` .env`, `.env.local`, `*.bootstrap.local`) stay ignored above.
!.env.standalone.development
!.env.standalone.test
!.env.standalone.staging
!.env.standalone.demo
!.env.standalone.production
!.env.cloud.development
!.env.cloud.test
!.env.cloud.staging
!.env.cloud.demo
!.env.cloud.production
