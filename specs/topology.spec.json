{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-zhiya",
  "applicationCode": "zhiya",
  "archetype": "application-client-root",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "standalone.production",
    "devBrowserPort": 3300,
    "devPcPort": 3400
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env"
  },
  "surfaces": {
    "h5.browser": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "clientHttpEnv": "SDKWORK_ZHIYA_H5_PUBLIC_HTTP_URL"
    },
    "pc.browser": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "clientHttpEnv": "SDKWORK_ZHIYA_PC_PUBLIC_HTTP_URL"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "h5-dev-server",
            "applicationRoot": "apps/sdkwork-zhiya-h5",
            "role": "client",
            "script": "pnpm --filter sdkwork-zhiya-h5 exec vite --host 0.0.0.0 --port 3300 --mode standalone.development",
            "portEnv": "SDKWORK_ZHIYA_H5_DEV_PORT"
          }
        ],
        "browserDeliveries": [
          {
            "id": "h5-browser-dev",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "h5"
            ],
            "renderers": {
              "h5": {
                "applicationRoot": "apps/sdkwork-zhiya-h5",
                "script": "dev",
                "defaultPort": 3300,
                "portEnv": "SDKWORK_ZHIYA_H5_DEV_PORT"
              },
              "pc": {
                "applicationRoot": "apps/sdkwork-zhiya-pc",
                "script": "dev",
                "defaultPort": 3400,
                "portEnv": "SDKWORK_ZHIYA_PC_DEV_PORT"
              }
            }
          }
        ],
        "accessEndpoints": [
          {
            "kind": "user-interface",
            "surface": "h5.browser",
            "url": "http://127.0.0.1:3300"
          },
          {
            "kind": "user-interface",
            "surface": "pc.browser",
            "url": "http://127.0.0.1:3400"
          }
        ]
      },
      "standalone.test": {
        "processes": [],
        "browserDeliveries": [
          {
            "id": "h5-browser-test",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "h5"
            ],
            "renderers": {
              "h5": {
                "applicationRoot": "apps/sdkwork-zhiya-h5",
                "script": "build:test",
                "buildOutput": "dist/standalone/test",
                "deliveryMode": "static",
                "spaFallback": "/index.html"
              },
              "pc": {
                "applicationRoot": "apps/sdkwork-zhiya-pc",
                "script": "build:test",
                "buildOutput": "dist/standalone/test",
                "deliveryMode": "static",
                "spaFallback": "/index.html"
              }
            }
          }
        ],
        "accessEndpoints": []
      },
      "standalone.staging": {
        "processes": [],
        "browserDeliveries": [
          {
            "id": "h5-browser-staging",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "h5"
            ],
            "renderers": {
              "h5": {
                "applicationRoot": "apps/sdkwork-zhiya-h5",
                "script": "build:staging",
                "buildOutput": "dist/standalone/staging",
                "deliveryMode": "static",
                "spaFallback": "/index.html"
              },
              "pc": {
                "applicationRoot": "apps/sdkwork-zhiya-pc",
                "script": "build:staging",
                "buildOutput": "dist/standalone/staging",
                "deliveryMode": "static",
                "spaFallback": "/index.html"
              }
            }
          }
        ],
        "accessEndpoints": []
      },
      "standalone.production": {
        "processes": [],
        "browserDeliveries": [
          {
            "id": "h5-browser-prod",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "h5"
            ],
            "renderers": {
              "h5": {
                "applicationRoot": "apps/sdkwork-zhiya-h5",
                "script": "build:prod",
                "buildOutput": "dist/standalone/prod",
                "deliveryMode": "static",
                "spaFallback": "/index.html"
              },
              "pc": {
                "applicationRoot": "apps/sdkwork-zhiya-pc",
                "script": "build:prod",
                "buildOutput": "dist/standalone/prod",
                "deliveryMode": "static",
                "spaFallback": "/index.html"
              }
            }
          }
        ],
        "accessEndpoints": []
      }
    }
  }
}