<view>
  <scroll-view scroll-x class="chips">
    <view wx:for="{{tabs}}" wx:key="id" class="chip {{status === item.id ? 'chip-active' : ''}}" data-id="{{item.id}}" bindtap="onStatus">{{item.label}}</view>
  </scroll-view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{orders.length === 0}}" class="empty">这里还空空如也</view>
  <block wx:else>
    <view wx:for="{{orders}}" wx:key="id" class="panel">
      <view class="row">
        <text class="row-glyph">{{item.emoji}}</text>
        <view style="flex: 1; min-width: 0;">
          <view class="row-title">{{item.title}}</view>
          <view class="row-desc">{{item.statusLabel}}{{item.childName ? ' · ' + item.childName : ''}} · {{item.createdAtLabel}}</view>
        </view>
        <view class="price">{{item.payableLabel}}</view>
      </view>
      <view class="actions">
        <button wx:if="{{item.status === 'pending-payment'}}" class="btn-ghost action-btn" size="mini" data-id="{{item.id}}" data-action="cancel" bindtap="onAction">取消</button>
        <button wx:if="{{item.status === 'pending-payment'}}" class="btn-brand action-btn" size="mini" data-id="{{item.id}}" bindtap="goPay">去支付</button>
        <button wx:if="{{item.status === 'upcoming' || item.status === 'ongoing'}}" class="btn-ghost action-btn" size="mini" data-id="{{item.id}}" data-action="refund" bindtap="onAction">申请退款</button>
        <button wx:if="{{item.status === 'pending-review'}}" class="btn-brand action-btn" size="mini" data-id="{{item.id}}" bindtap="goReview">去评价</button>
      </view>
    </view>
  </block>
</view>
