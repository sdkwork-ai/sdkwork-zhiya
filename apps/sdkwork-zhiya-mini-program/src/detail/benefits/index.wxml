<view>
  <view wx:for="{{benefits}}" wx:key="activityId" class="panel">
    <view class="row" data-id="{{item.activityId}}" bindtap="onToggle">
      <text class="row-glyph">{{item.emoji}}</text>
      <view style="flex: 1; min-width: 0;">
        <view class="row-title">{{item.title}}</view>
        <view class="row-desc">{{item.orgName}} · {{item.priceLabel}}</view>
      </view>
      <text wx:if="{{item.booked}}" class="tag">{{item.checkedIn ? '已签到' : '已预约'}}</text>
      <text wx:elif="{{selected === item.activityId}}" class="row-desc">收起</text>
      <text wx:else style="color: var(--sdk-color-brand); font-size: 26rpx;">预约</text>
    </view>
    <view wx:if="{{item.booked && item.voucherCode}}" class="row-desc" style="padding: 0 24rpx 20rpx; letter-spacing: 2px;">凭证码 {{item.voucherCode}}</view>

    <view wx:if="{{selected === item.activityId && !item.booked}}" style="padding: 0 24rpx 24rpx;">
      <view class="row-desc" style="margin-bottom: 8rpx;">选择参加儿童</view>
      <view class="chips" style="padding: 0;">
        <view wx:for="{{children}}" wx:key="id" class="chip {{childId === item.id ? 'chip-active' : ''}}" data-id="{{item.id}}" bindtap="onChild">{{item.nickname}}</view>
      </view>
      <view class="row-desc" style="margin: 16rpx 0 8rpx;">选择场次</view>
      <view class="chips" style="padding: 0;">
        <view wx:for="{{item.sessions}}" wx:key="id" class="chip {{sessionId === item.id ? 'chip-active' : ''}}" data-id="{{item.id}}" bindtap="onSession">
          {{item.label}}（{{item.remaining === 0 ? '满员' : '剩' + item.remaining}}）
        </view>
      </view>
      <view wx:if="{{error}}" class="row-desc" style="color: var(--sdk-color-danger); margin-top: 8rpx;">{{error}}</view>
      <button class="btn-brand" style="margin-top: 20rpx;" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? '预约中…' : '确认预约'}}</button>
    </view>
  </view>
  <view class="row-desc" style="padding: 0 32rpx; line-height: 1.7;">
    权益规则：包内每个活动可预约一次，预约后到场出示凭证核销；未核销的权益可取消预约后退款。
  </view>
</view>
