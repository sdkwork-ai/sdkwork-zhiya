<view class="login">
  <view class="logo">🦆</view>
  <view class="slogan">知孩子，也知教育</view>
  <view class="form">
    <input class="input" value="{{phone}}" bindinput="onPhone" type="number" maxlength="11" placeholder="手机号" />
    <view class="code-row">
      <input class="input code" value="{{code}}" bindinput="onCode" type="number" maxlength="6" placeholder="验证码" />
      <view class="send">获取验证码</view>
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="btn-brand submit" bindtap="onSubmit" disabled="{{submitting}}">登录 / 注册</button>
    <view class="hint">演示环境：输入任意手机号 + 任意 6 位验证码即可登录</view>
  </view>
</view>
