/* Zhiya mini-program global styles — semantic tokens mirror the H5/PC theme. */
page {
  --sdk-color-surface-canvas: #fafafa;
  --sdk-color-surface-panel: #ffffff;
  --sdk-color-text-primary: #18181b;
  --sdk-color-text-secondary: #52525b;
  --sdk-color-text-muted: #a1a1aa;
  --sdk-color-brand: #d97706;
  --sdk-color-brand-soft: #fffbeb;
  --sdk-color-success: #16a34a;
  --sdk-color-danger: #dc2626;
  --sdk-color-border-subtle: #e4e4e7;
  background-color: var(--sdk-color-surface-canvas);
  color: var(--sdk-color-text-primary);
  font-size: 28rpx;
}

.panel {
  margin: 16rpx 24rpx;
  border-radius: 24rpx;
  background-color: var(--sdk-color-surface-panel);
  border: 1rpx solid var(--sdk-color-border-subtle);
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--sdk-color-border-subtle);
}

.row:last-child { border-bottom: none; }

.row-title { font-size: 30rpx; font-weight: 500; color: var(--sdk-color-text-primary); }
.row-desc { font-size: 24rpx; color: var(--sdk-color-text-secondary); margin-top: 4rpx; }
.row-glyph { font-size: 40rpx; }

.btn-brand {
  background-color: var(--sdk-color-brand);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-ghost {
  border: 1rpx solid var(--sdk-color-border-subtle);
  color: var(--sdk-color-text-secondary);
  border-radius: 999rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--sdk-color-text-secondary);
  background-color: var(--sdk-color-surface-panel);
  border: 1rpx solid var(--sdk-color-border-subtle);
}

.chip-active {
  background-color: var(--sdk-color-brand);
  color: #ffffff;
  border-color: var(--sdk-color-brand);
}

.page-title { font-size: 40rpx; font-weight: 600; padding: 32rpx 32rpx 8rpx; }
.page-sub { font-size: 24rpx; color: var(--sdk-color-text-muted); padding: 0 32rpx 16rpx; }
.empty { text-align: center; color: var(--sdk-color-text-muted); padding: 80rpx 0; font-size: 26rpx; }
.price { color: var(--sdk-color-brand); font-weight: 600; }
.price-original { color: var(--sdk-color-text-muted); font-size: 22rpx; text-decoration: line-through; margin-left: 8rpx; }
.tag { font-size: 22rpx; color: var(--sdk-color-brand); background-color: var(--sdk-color-brand-soft); border-radius: 999rpx; padding: 4rpx 16rpx; }
