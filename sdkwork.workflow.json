{
  "schemaVersion": "2026-06-06.sdkwork.workflow.v1",
  "app": {
    "id": "sdkwork-zhiya",
    "name": "Zhiya",
    "repository": "sdkwork-ai/sdkwork-zhiya",
    "sourcePath": ".",
    "configPath": "sdkwork.app.config.json",
    "description": "Zhiya (知鸭) — AI 时代的家庭教育与活动平台: H5 + PC + WeChat mini-program + Flutter mobile surfaces over one shared service family."
  },
  "release": {
    "artifactPrefix": "sdkwork-zhiya",
    "defaultVersion": "0.1.0",
    "changelog": {
      "source": "app-manifest",
      "maxCommitSubjects": 50
    }
  },
  "dependencies": [],
  "verificationDependencies": [],
  "targets": [
    {
      "id": "browser-universal-standalone-h5-tar-gz",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "browser",
      "profile": "browser",
      "platform": "browser",
      "architecture": "universal",
      "variant": "h5",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/release-packages/sdkwork-zhiya-browser-universal-standalone-h5-tar-gz-0.1.0.tar.gz",
        "dist/release-evidence/browser-universal-standalone-h5-tar-gz/*"
      ],
      "artifactPath": "dist/release-packages/sdkwork-zhiya-browser-universal-standalone-h5-tar-gz-0.1.0.tar.gz"
    },
    {
      "id": "browser-universal-standalone-pc-tar-gz",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "browser",
      "profile": "browser",
      "platform": "browser",
      "architecture": "universal",
      "variant": "pc",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/release-packages/sdkwork-zhiya-browser-universal-standalone-pc-tar-gz-0.1.0.tar.gz",
        "dist/release-evidence/browser-universal-standalone-pc-tar-gz/*"
      ],
      "artifactPath": "dist/release-packages/sdkwork-zhiya-browser-universal-standalone-pc-tar-gz-0.1.0.tar.gz"
    }
  ],
  "security": {
    "artifactAttestations": true,
    "sbomRequired": true,
    "signingRequired": false
  },
  "publish": {
    "workflowArtifact": true,
    "githubRelease": false,
    "retentionDays": 30
  },
  "deployments": []
}
